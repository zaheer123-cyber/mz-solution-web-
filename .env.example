# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Leave blank or omit for automatic fallback to in-memory MongoDB for easy local testing
MONGODB_URI=mongodb://127.0.0.1:27017/mzsolution

# Security & Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Credentials (Used when running seed script)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Admin User

# Email / SMTP Configuration (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MzSolution Inquiries" <no-reply@mzsolution.com>
NOTIFICATION_RECEIVER_EMAIL=admin@mzsolution.com

# File Upload Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
